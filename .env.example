APP_NAME="Afaq Family"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heirloom
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true (cookies only over HTTPS) and TRUSTED_PROXIES="*" or a
# comma-separated list of your load balancer / reverse proxy IPs or CIDRs (see README, "Deploy it").
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# On shared hosting a cron entry runs the queue every minute (see README, "Shared hosting").
# Keep DB_QUEUE_RETRY_AFTER above the jobs' 540 s timeout so a job is never picked up twice.
DB_QUEUE_RETRY_AFTER=600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Shared hosting (cPanel/Plesk): use the account's own SMTP server. Create a mailbox such as
# no-reply@yourdomain.com and set MAIL_MAILER=smtp with:
#   MAIL_HOST=mail.yourdomain.com   MAIL_PORT=465   MAIL_SCHEME=smtps   (or MAIL_PORT=587 MAIL_SCHEME=smtp for STARTTLS)
#   MAIL_USERNAME=no-reply@yourdomain.com   MAIL_PASSWORD=<mailbox password>   MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Pricing, plans and limits (payments not wired up yet)
BILLING_ENABLED=false
